{
  "name": "glyphcast",
  "private": true,
  "version": "0.1.0",
  "description": "Turn photos into ASCII art, braille, dots, pixels, toy bricks, isometric cubes and dithered prints, right in the browser.",
  "type": "module",
  "scripts": {
